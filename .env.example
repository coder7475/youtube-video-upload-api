# FastAPI Application Settings
APP_NAME="YouTube Scheduler API"
APP_DESCRIPTION="API for scheduling YouTube video uploads"
APP_VERSION="0.1.0"
DEBUG=True
SECRET_KEY="your-super-secret-key-change-this"  # Used for JWT tokens
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# CORS Settings
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# Database Settings
DATABASE_URL="sqlite:///./app.db"  # For development
# DATABASE_URL="postgresql://user:password@localhost:5432/youtube_scheduler"  # For production

# Google API Settings
# You need to create a project in the Google Cloud Console and enable the YouTube Data API
# Then create OAuth 2.0 credentials and add the callback URI to the allowed redirects
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/youtube/callback"
GOOGLE_AUTH_SCOPES="https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube"

# Redis Settings (for Celery)
REDIS_URL="redis://localhost:6379/0"

# Upload Settings
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE=104857600  # 100 MB in bytes

